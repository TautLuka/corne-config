#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        MouseCombo {
            bindings = <&mo 0>;
            key-positions = <37 40>;
            layers = <0 1>;
        };
    };

    behaviors {
        hm_mod: hm_mod {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_MOD";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <200>;
        };
    };

    macros {
        AltTab: AltTab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press>, <&kp>;

            label = "ALTTAB";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            display-name = "Base";
            bindings = <
&kp ESCAPE        &kp Q  &kp W  &kp E  &kp R  &kp T        &kp Y            &kp U  &kp I      &kp O    &kp P          &kp BSPC
&kp TAB           &kp A  &kp S  &kp D  &kp F  &kp G        &kp H            &kp J  &kp K      &kp L    &kp SEMICOLON  &kp SQT
&kp LEFT_CONTROL  &kp Z  &kp X  &kp C  &kp V  &kp B        &kp N            &kp M  &kp COMMA  &kp DOT  &kp FSLH       &trans
                                &mo 3  &mo 1  &kp SPACE    &kp RIGHT_SHIFT  &mo 2  &kp ENTER
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "numbers";
            bindings = <
&kp GRAVE  &kp N1  &kp N2  &kp N3          &kp N4  &kp N5    &trans  &kp LEFT_BRACE        &kp RIGHT_BRACE        &trans  &trans  &trans
&trans     &kp N6  &kp N7  &kp N8          &kp N9  &kp N0    &trans  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans  &trans  &trans
&trans     &trans  &trans  &bt BT_CLR_ALL  &trans  &trans    &trans  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &trans  &trans  &trans
                           &trans          &trans  &trans    &trans  &trans                &trans
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "Raise";
            bindings = <
&kp TAB    &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT    &kp CARET  &kp AMPS   &kp KP_MULTIPLY  &kp LPAR  &kp RPAR  &kp BSPC
&kp LCTRL  &trans    &trans  &trans    &trans    &trans       &kp MINUS  &kp EQUAL  &kp LBKT         &kp RBKT  &kp BSLH  &kp GRAVE
&kp LSHFT  &trans    &trans  &trans    &trans    &trans       &kp UNDER  &kp PLUS   &kp LBRC         &kp RBRC  &kp PIPE  &kp TILDE
                             &trans    &trans    &kp SPACE    &kp RET    &trans     &kp RALT
            >;
        };

        layer_4 {
            bindings = <
&trans            &trans  &trans         &kp LG(E)  &kp LG(R)  &kp LC(LS(ESCAPE))    &trans  &trans  &trans  &trans     &trans  &trans
&kp LA(TAB)       &trans  &kp LS(LG(S))  &trans     &trans     &trans                &trans  &trans  &trans  &kp LG(L)  &trans  &trans
&kp LEFT_COMMAND  &trans  &trans         &trans     &trans     &trans                &trans  &trans  &trans  &trans     &trans  &trans
                                         &trans     &trans     &trans                &trans  &trans  &trans
            >;
        };
    };
};
